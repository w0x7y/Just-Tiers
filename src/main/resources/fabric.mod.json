{
  "schemaVersion": 1,
  "id": "justtiers",
  "version": "${version}",
  "name": "Just-Tiers",
  "icon": "assets/justtiers/icon.png",
  "description": "Displays a player's PvP tier in their nametag, from PvPTiers, PvPHQ, SubTiers and NovaTiers.",
  "authors": ["Idan Gilboa"],
  "contact": { "sources": "https://github.com/w0x7y/Just-Tiers" },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.w0x7y.justtiers.JustTiersClient"],
    "modmenu": ["com.w0x7y.justtiers.gui.ModMenuIntegration"]
  },
  "mixins": ["justtiers.mixins.json"],
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "java": ">=${java}",
    "yet_another_config_lib_v3": ">=${yacl}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
