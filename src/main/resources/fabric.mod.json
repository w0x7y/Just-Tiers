{
  "schemaVersion": 1,
  "id": "justtiers",
  "version": "${version}",
  "name": "Just-Tiers",
  "description": "Displays a player's PvP tier in their nametag, from MCTiers, SubTiers and NovaTiers.",
  "authors": ["Idan Gilboa"],
  "contact": { "sources": "https://github.com/w0x7y/Just-Tiers" },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.w0x7y.justtiers.JustTiersClient"]
  },
  "mixins": ["justtiers.mixins.json"],
  "depends": {
    "minecraft": ">=26.2",
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "java": ">=25"
  }
}
